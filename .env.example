# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Written automatically by `neon deploy` / `neon env pull` into .env.local.
# Pooled endpoint (-pooler host) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct endpoint (no -pooler) — used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# REQUIRED in production: the teacher/admin sign-in password. No default.
ADMIN_PASSWORD=""

# ─── Email (password reset) ──────────────────────────────────────────────────
# Leave empty to disable outgoing mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
