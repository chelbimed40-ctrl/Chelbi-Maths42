{
  "name": "chelbi-maths42",
  "version": "0.1.0",
  "private": true,
  "description": "Maths practice API on Neon Postgres",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/migrate.js",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/server.js",
    "verify": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify.mjs",
    "local-pg": "node scripts/local-pg.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
